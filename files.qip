# Aleste 520EX para MiSTer
#
# El nucleo viene del submodulo rtl/aleste520ex (github.com/shaeon/aleste520ex),
# que no se modifica. NO se incluye su files.qip: trae los modulos de MiST
# (user_io, osd, mist_video...) y su entidad superior, que chocarian con sys/.
# La lista es la de aleste520ex/files.qip sin mist-modules, dac.vhd ni
# aleste_mist_top.sv.
#
# Las tablas .mem de la paleta ($readmemh) las copia rtl/pre_flow.tcl a la
# carpeta del proyecto antes de cada compilacion.

set_global_assignment -name SDC_FILE Aleste520EX.sdc
set_global_assignment -name SYSTEMVERILOG_FILE Aleste520EX.sv
set_global_assignment -name QIP_FILE rtl/pll_vid.qip
set_global_assignment -name SYSTEMVERILOG_FILE rtl/native_resync.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/aleste520ex/aleste-lx/src/components/reset/reset_controller.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/aleste520ex/aleste-lx/src/components/memory/sdram/sdram_wishbone.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/aleste520ex/rtl/mc6845mod.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/aleste520ex/aleste-lx/src/components/video/hdmi_scaler/dual_port_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/aleste520ex/aleste-lx/src/components/video/hdmi_scaler/hdmi_scaler.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/aleste520ex/rtl/cpc_colors.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/aleste520ex/aleste-lx/src/components/video/palette/msx_colors.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/aleste520ex/rtl/color_palette.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/aleste520ex/aleste-lx/src/components/video/video_buffer/video_buffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/aleste520ex/rtl/pixel_pipeline.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/aleste520ex/aleste-lx/src/systems/aleste_video/wb_arbiter.sv
